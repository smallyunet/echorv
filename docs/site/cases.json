    "release": "https://github.com/smallyunet/echorv/releases/latest",
    "install": "cargo install --git https://github.com/smallyunet/echorv --tag v0.2.0",
    "boundary": "Spike execution and log import happen locally. The static page ships frozen trace-derived evidence and never runs firmware.",
